.footer { background: var(--teal-dark); color: rgba(255,255,255,0.7); padding: 48px 24px 24px; margin-top: 48px; }
.inner { }

/* Desktop: 5 sutun */
.grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1.4fr; gap: 36px; margin-bottom: 36px; align-items: start; }

.brand p { font-size: 13px; line-height: 1.8; margin-top: 10px; margin-bottom: 0; }
.badges { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
.badge { font-size: 11px; background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.8); padding: 4px 10px; border-radius: 20px; }

.col h6 { font-size: 11px; font-weight: 700; color: white; margin-bottom: 14px; margin-top: 0; text-transform: uppercase; letter-spacing: 0.8px; }
.col a { display: block; font-size: 13px; color: rgba(255,255,255,0.6); margin-bottom: 9px; transition: color 0.15s; text-decoration: none; }
.col a:hover { color: white; }

.proKutu { background: rgba(245,166,35,0.1); border: 1px solid rgba(245,166,35,0.28); border-radius: 10px; padding: 16px 18px; }
.proBaslik { font-size: 11px; font-weight: 700; color: #F5A623; letter-spacing: 0.8px; margin-bottom: 12px; }
.proOzellikler { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-bottom: 14px; }
.proOzellik { display: flex; align-items: center; gap: 5px; }
.proCheck { font-size: 10px; color: #F5A623; }
.proOzellik span:last-child { font-size: 11px; color: rgba(255,255,255,0.75); }
.proBtn { display: block; background: #F5A623; color: #1A1D23; font-size: 12px; font-weight: 700; padding: 9px 12px; border-radius: 7px; text-align: center; text-decoration: none; }
.proBtn:hover { background: #e09800; }

.bottom { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: rgba(255,255,255,0.4); flex-wrap: wrap; gap: 8px; }
.bottomLinks { display: flex; gap: 16px; }
.bottomLinks a { font-size: 12px; color: rgba(255,255,255,0.4); text-decoration: none; }
.bottomLinks a:hover { color: rgba(255,255,255,0.7); }
.motto { }

/* Tablet: 3 sutun */
@media (max-width: 1024px) {
  .grid { grid-template-columns: 2fr 1fr 1fr; gap: 28px; }
  .proKutu { grid-column: 1 / -1; }
  .proOzellikler { grid-template-columns: repeat(3, 1fr); }
}

/* Mobil: 2 sutun */
@media (max-width: 640px) {
  .footer { padding: 36px 16px 20px; }
  .grid { grid-template-columns: 1fr 1fr; gap: 24px; }
  .brand { grid-column: 1 / -1; }
  .proKutu { grid-column: 1 / -1; }
  .proOzellikler { grid-template-columns: 1fr 1fr; }
  .bottom { flex-direction: column; align-items: flex-start; gap: 10px; }
  .bottomLinks { flex-wrap: wrap; gap: 12px; }
}

/* Kucuk mobil: 1 sutun */
@media (max-width: 380px) {
  .grid { grid-template-columns: 1fr; }
}
