  'emlak-villa':       { ikon:'🏡', renk:'#16A34A', bg:'#F0FDF4', etiket:'Villa Arıyor' },
  'emlak-arsa':        { ikon:'🌿', renk:'#D97706', bg:'#FFFBEB', etiket:'Arsa Arıyor' },
  'emlak-isyeri':      { ikon:'🏬', renk:'#7C3AED', bg:'#FDF4FF', etiket:'İşyeri Arıyor' },
  'emlak-mustakil ev': { ikon:'🏠', renk:'#E11D48', bg:'#FFF1F2', etiket:'Müstakil Arıyor' },
  'emlak-müstakil ev': { ikon:'🏠', renk:'#E11D48', bg:'#FFF1F2', etiket:'Müstakil Arıyor' },
  'emlak-depo':        { ikon:'🏭', renk:'#475569', bg:'#F8FAFC', etiket:'Depo Arıyor' },
