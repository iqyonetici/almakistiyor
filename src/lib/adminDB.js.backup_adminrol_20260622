// ===== İLAN LİMİT KONTROLÜ =====
// Kullanıcının bugün kaç ilan verdiğini say
export async function bugunkuIlanSayisi(email) {
  if (!supabase || !email) return 0
  const bugun = new Date(); bugun.setHours(0,0,0,0)
  const { count } = await supabase.from('ilanlar')
    .select('*',{count:'exact',head:true})
    .eq('kullanici_email', email)
    .gte('created_at', bugun.toISOString())
  return count || 0
}

// ===== DESTEK TALEPLERİ (kullanıcı tarafı — /iletisim formu) =====
// İletişim formundan gelen yeni destek talebini destek_talepleri tablosuna yazar.
// RLS: "Herkes destek talebi olusturabilir" INSERT policy'si zaten kurulu
// (bkz. CLAUDE.md — iletisim sayfası kurulumu).
export async function destekTalebiOlustur(form) {
  if (!supabase) return { data: null, error: 'Supabase bağlı değil' }
  const { data, error } = await supabase.rpc('destek_talebi_olustur', {
    p_tur: form.tur || 'soru',
    p_konu: form.konu,
    p_kullanici_ad: form.ad || null,
    p_kullanici_email: form.email,
    p_mesaj: form.mesaj,
  })
  return { data, error }
}

