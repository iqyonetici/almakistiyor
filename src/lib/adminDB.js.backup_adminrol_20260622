// src/lib/adminDB.js — admin panel veri fonksiyonları
import { supabase } from './supabase'

// ===== DASHBOARD İSTATİSTİKLERİ =====
export async function dashboardStats() {
  if (!supabase) return {}
  const bugun = new Date(); bugun.setHours(0,0,0,0)
  const buguniso = bugun.toISOString()

  const [ilanAktif, ilanBekleyen, ilanToplam, kullanici, bugunIlan, bugunUye] = await Promise.all([
    supabase.from('ilanlar').select('*',{count:'exact',head:true}).eq('durum','aktif'),
    supabase.from('ilanlar').select('*',{count:'exact',head:true}).eq('onay_durumu','beklemede'),
    supabase.from('ilanlar').select('*',{count:'exact',head:true}),
    supabase.from('kullanicilar').select('*',{count:'exact',head:true}),
    supabase.from('ilanlar').select('*',{count:'exact',head:true}).gte('created_at',buguniso),
    supabase.from('kullanicilar').select('*',{count:'exact',head:true}).gte('created_at',buguniso),
  ])

  return {
    ilanAktif: ilanAktif.count || 0,
    ilanBekleyen: ilanBekleyen.count || 0,
    ilanToplam: ilanToplam.count || 0,
    kullanici: kullanici.count || 0,
    bugunIlan: bugunIlan.count || 0,
    bugunUye: bugunUye.count || 0,
  }
}

// Son 7 günün ilan sayısı (grafik için)
export async function son7GunIlan() {
  if (!supabase) return []
  const sonuc = []
  for (let i = 6; i >= 0; i--) {
    const gun = new Date(); gun.setDate(gun.getDate() - i); gun.setHours(0,0,0,0)
    const ertesi = new Date(gun); ertesi.setDate(ertesi.getDate() + 1)
    const { count } = await supabase.from('ilanlar')
      .select('*',{count:'exact',head:true})
      .gte('created_at', gun.toISOString())
      .lt('created_at', ertesi.toISOString())
    sonuc.push({ gun: gun.toLocaleDateString('tr-TR',{weekday:'short'}), sayi: count || 0 })
  }
  return sonuc
}

// ===== KULLANICI YÖNETİMİ =====
export async function kullanicilariGetir(arama = '', filtreler = {}) {
  if (!supabase) return []
  const { sehir = '', paket = '', siralama = 'yeni' } = filtreler
  let q = supabase.from('kullanicilar').select('*').eq('silindi', false)
  if (arama) q = q.or(`ad.ilike.%${arama}%,email.ilike.%${arama}%`)
  if (sehir) q = q.eq('sehir', sehir)
  if (paket) q = q.eq('paket', paket)
  q = q.order('created_at', { ascending: siralama === 'eski' }).limit(200)
  const { data } = await q
  return data || []
}

// Kayıtlı kullanıcıların bulunduğu benzersiz şehir listesi (filtre dropdown'ı için)
export async function kullaniciSehirleriGetir() {
  if (!supabase) return []
  const { data } = await supabase.from('kullanicilar').select('sehir').eq('silindi', false).not('sehir', 'is', null)
  const set = new Set((data || []).map(r => r.sehir).filter(Boolean))
  return Array.from(set).sort((a, b) => a.localeCompare(b, 'tr'))
}

export async function kullaniciEngelle(id, engelli, not = null) {
  if (!supabase) return
  const guncelleme = { engelli }
  if (engelli) guncelleme.engel_notu = not || null
  return await supabase.from('kullanicilar').update(guncelleme).eq('id', id)
}

export async function kullaniciSil(id, email) {
  if (!supabase) return
  const sonuc = await supabase.from('kullanicilar').update({ silindi: true }).eq('id', id)
  if (email) {
    await supabase.from('ilanlar').update({ durum: 'pasif' }).eq('kullanici_email', email)
  }
  return sonuc
}

export async function kullaniciSifreSifirla(email) {
  if (!supabase) return { error: 'Supabase yok' }
  const redirectTo = typeof window !== 'undefined' ? `${window.location.origin}/giris` : undefined
  const { error } = await supabase.auth.resetPasswordForEmail(email, redirectTo ? { redirectTo } : undefined)
  return { error: error?.message || null }
}

export async function kullaniciPaketDegistir(id, paket) {
  if (!supabase) return
  // Paketin ilan + mesaj haklarını DB'den çek (admin panelden değiştirilebilir)
  const { data: p } = await supabase.from('paketler').select('gunluk_ilan, gunluk_mesaj').eq('kod', paket).single()
  const gunlukIlan = p?.gunluk_ilan ?? 3
  const gunlukMesaj = p?.gunluk_mesaj ?? 1
  return await supabase.from('kullanicilar').update({
    paket,
    gunluk_ilan_hakki: gunlukIlan,
    gunluk_mesaj_hakki: gunlukMesaj,
    paket_bitis: paket === 'ucretsiz' ? null : new Date(Date.now()+30*24*60*60*1000).toISOString(),
  }).eq('id', id)
}

// Kullanıcı detay paneli: ilanları + mesajları + şikayet/destek kayıtları (email bazlı eşleştirme)
export async function kullaniciDetay(email) {
  if (!supabase || !email) return { ilanlar: [], mesajlar: [], destek: [], sikayetlerYapilan: [], sikayetlerAlinan: [] }

  const [ilanlarR, mesajlarR, destekR, sikayetYapilanR] = await Promise.all([
    supabase.from('ilanlar').select('*').eq('kullanici_email', email).order('created_at',{ascending:false}),
    supabase.from('mesajlar').select('*').or(`gonderen_email.eq.${email},alici_email.eq.${email}`).order('created_at',{ascending:false}).limit(50),
    supabase.from('destek_talepleri').select('*').eq('kullanici_email', email).order('created_at',{ascending:false}),
    supabase.from('sikayetler').select('*').eq('sikayet_eden_email', email).order('created_at',{ascending:false}),
  ])

  const ilanlar = ilanlarR.data || []
  // Kullanıcının ilanları hakkında yapılan şikayetler (ilan_id tip uyumsuzluğuna karşı text cast ile manuel eşleştirme)
  let sikayetlerAlinan = []
  if (ilanlar.length > 0) {
    const { data: tumSikayetler } = await supabase.from('sikayetler').select('*')
    const ilanIdSeti = new Set(ilanlar.map(i => String(i.id)))
    sikayetlerAlinan = (tumSikayetler || []).filter(s => ilanIdSeti.has(String(s.ilan_id)))
  }

  return {
    ilanlar,
    mesajlar: mesajlarR.data || [],
    destek: destekR.data || [],
    sikayetlerYapilan: sikayetYapilanR.data || [],
    sikayetlerAlinan,
  }
}

